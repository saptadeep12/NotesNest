# Backend - local defaults
APP_ENV=development
DATABASE_URL=sqlite:///./notesnest.db
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=./storage
STORAGE_BACKEND=local

